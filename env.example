# NOC TV Wall — environment configuration (used in development and Docker)

# SQLite database location. In Docker, this is mounted as a volume for persistence.
DATABASE_URL=file:/home/z/my-project/db/custom.db

# NextAuth.js (required)
# Generate a secret with: openssl rand -base64 32
NEXTAUTH_SECRET=replace-with-a-long-random-secret-string

# Public URL where the app is reachable.
# - Docker: http://localhost:8080 (or your domain)
# - Local dev: http://localhost:3000
NEXTAUTH_URL=http://localhost:8080

# Operator credentials
# Simple: set a single admin password
NOC_ADMIN_PASSWORD=admin123
NOC_ADMIN_NAME=NOC Admin

# OR define multiple users (overrides the admin password):
# NOC_USERS=alice:alicePass,bob:bobPass,carol:carolPass

# Optional: Slack-compatible incoming webhook URL (Slack, Teams, Mattermost, Discord)
# When set, new/resolved/reactivated/deleted updates are mirrored to this channel.
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your/webhook/url
